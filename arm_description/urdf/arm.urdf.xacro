<?xml version="1.0"?>
<robot name="arm">

    <!--MATERIALS-->
    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>
    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <!--BODY-->
    <link name="base_link">
        <visual>
            <geometry>
                <sphere radius="0.2"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>

    <link name="link1">
        <visual>
            <geometry>
                <cylinder length="1.0" radius="0.1"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0.65"/>
            <material name="white"/>
        </visual>
    </link>

    <joint name="joint1" type="revolute">
        <parent link="base_link"/>
        <child link="link1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.3" upper="1.3" effort="10" velocity="1"/>
    </joint>

    <link name ="link1_to_joint2">
        <visual>
            <geometry>
                <sphere radius="0.2"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 1.3"/>
            <material name="black"/>
        </visual>
    </link>

    <joint name="joint2_to_link2" type="fixed">
        <parent link="link1"/>
        <child link="link1_to_joint2"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="link2">
        <visual>
            <geometry>
                <cylinder length="1.0" radius="0.1"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0.65"/>
            <material name="white"/>
        </visual>
    </link>

    <joint name="joint2" type="revolute">
        <parent link="link1_to_joint2"/>
        <child link="link2"/>
        <origin xyz="0 0 1.3" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.3" upper="1.3" effort="10" velocity="1"/>
    </joint>

    <link name ="link2_to_joint3">
        <visual>
            <geometry>
                <sphere radius="0.2"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 1.3"/>
            <material name="black"/>
        </visual>
    </link>

    <joint name="joint3_to_link3" type="fixed">
        <parent link="link2"/>
        <child link="link2_to_joint3"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="link3">
        <visual>
            <geometry>
                <cylinder length="1.0" radius="0.1"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0.65"/>
            <material name="white"/>
        </visual>
    </link>

    <joint name="joint3" type="revolute">
        <parent link="link2_to_joint3"/>
        <child link="link3"/>
        <origin xyz="0 0 1.3" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.3" upper="1.3" effort="10" velocity="1"/>
    </joint>

    <link name="gripper_hand"> 
        <visual>
            <geometry>
                <box size="0.2 0.5 0.2"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0.1"/>
            <material name="black"/>
        </visual>
    </link>

    <joint name="gripper_joint" type="fixed">
        <parent link="link3"/>
        <child link="gripper_hand"/>
        <origin xyz="0 0 1.1" rpy="0 0 0"/>
    </joint>

    <link name="gripper_finger_left">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.4"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0.18 0.3"/>
            <material name="white"/>
        </visual>
    </link> 

    <joint name="gripper_finger_left_joint" type="prismatic">
        <parent link="gripper_hand"/>
        <child link="gripper_finger_left"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.13" upper="0" effort="10" velocity="1"/>
    </joint>

    <link name="gripper_finger_right">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.4"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 -0.18 0.3"/>
            <material name="white"/>
        </visual>
    </link>

    <joint name="gripper_finger_right_joint" type="prismatic">
        <parent link="gripper_hand"/>
        <child link="gripper_finger_right"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="0.13" effort="10" velocity="1"/>
    </joint>

</robot>