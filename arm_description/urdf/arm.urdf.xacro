<?xml version="1.0"?>
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== PROPERTIES ===== -->
  <!-- Arm -->
  <xacro:property name="segment_length" value="1.3"/>   <!-- distance between two joints -->
  <xacro:property name="link_length"    value="1.0"/>   <!-- length of each cylinder -->
  <xacro:property name="link_radius"    value="0.1"/>
  <xacro:property name="joint_radius"   value="0.2"/>   <!-- sphere at each joint -->
  <xacro:property name="joint_limit"    value="1.3"/>   <!-- rad, symmetric: -limit to +limit -->
  <xacro:property name="joint_effort"   value="10"/>
  <xacro:property name="joint_velocity" value="1"/>

  <!-- Gripper -->
  <xacro:property name="hand_offset"     value="1.1"/>  <!-- hand position along link3 -->
  <xacro:property name="hand_x"          value="0.2"/>
  <xacro:property name="hand_y"          value="0.5"/>
  <xacro:property name="hand_z"          value="0.2"/>
  <xacro:property name="finger_x"        value="0.1"/>
  <xacro:property name="finger_y"        value="0.1"/>
  <xacro:property name="finger_z"        value="0.4"/>
  <xacro:property name="finger_spacing"  value="0.18"/> <!-- distance of each finger from the center -->
  <xacro:property name="finger_height"   value="0.3"/>
  <xacro:property name="finger_travel"   value="0.13"/> <!-- how far each finger closes -->

  <!-- ===== MATERIALS ===== -->
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <!-- ===== MACROS ===== -->
  <!-- One arm segment: a cylinder, an optional sphere at its top, and the revolute joint that drives it -->
  <xacro:macro name="arm_segment" params="index parent joint_z top_sphere">
    <link name="link${index}">
      <visual>
        <geometry>
          <cylinder length="${link_length}" radius="${link_radius}"/>
        </geometry>
        <origin xyz="0 0 ${segment_length/2}" rpy="0 0 0"/>
        <material name="white"/>
      </visual>
      <xacro:if value="${top_sphere}">
        <visual>
          <geometry>
            <sphere radius="${joint_radius}"/>
          </geometry>
          <origin xyz="0 0 ${segment_length}" rpy="0 0 0"/>
          <material name="black"/>
        </visual>
      </xacro:if>
    </link>

    <joint name="joint${index}" type="revolute">
      <parent link="${parent}"/>
      <child link="link${index}"/>
      <origin xyz="0 0 ${joint_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
  </xacro:macro>

  <!-- One gripper finger. reflect = 1 for left, -1 for right -->
  <xacro:macro name="finger" params="side reflect">
    <link name="gripper_finger_${side}">
      <visual>
        <geometry>
          <box size="${finger_x} ${finger_y} ${finger_z}"/>
        </geometry>
        <origin xyz="0 ${reflect*finger_spacing} ${finger_height}" rpy="0 0 0"/>
        <material name="white"/>
      </visual>
    </link>

    <joint name="gripper_finger_${side}_joint" type="prismatic">
      <parent link="gripper_hand"/>
      <child link="gripper_finger_${side}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 ${-reflect} 0"/>
      <limit lower="0" upper="${finger_travel}" effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
  </xacro:macro>

  <!-- ===== ROBOT ===== -->
  <link name="base_link">
    <visual>
      <geometry>
        <sphere radius="${joint_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <xacro:arm_segment index="1" parent="base_link" joint_z="0"                 top_sphere="true"/>
  <xacro:arm_segment index="2" parent="link1"     joint_z="${segment_length}" top_sphere="true"/>
  <xacro:arm_segment index="3" parent="link2"     joint_z="${segment_length}" top_sphere="false"/>

  <link name="gripper_hand">
    <visual>
      <geometry>
        <box size="${hand_x} ${hand_y} ${hand_z}"/>
      </geometry>
      <origin xyz="0 0 ${hand_z/2}" rpy="0 0 0"/>
      <material name="black"/>
    </visual>
  </link>

  <joint name="gripper_joint" type="fixed">
    <parent link="link3"/>
    <child link="gripper_hand"/>
    <origin xyz="0 0 ${hand_offset}" rpy="0 0 0"/>
  </joint>

  <xacro:finger side="left"  reflect="1"/>
  <xacro:finger side="right" reflect="-1"/>

</robot>